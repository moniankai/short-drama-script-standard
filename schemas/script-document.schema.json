{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moniankai/short-drama-script-standard/blob/main/schemas/script-document.schema.json",
  "title": "ShortDramaAndAIManjuScriptDocument",
  "description": "竖屏短剧与 AI 漫剧标准文字台本结构化数据契约（MIT License · 规范与校验由 short-drama-script-standard 维护，在线体检入口见 https://52juben.com/show/tools/）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "format_mode", "episodes"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "format_mode": {
      "type": "string",
      "enum": ["ai_manju", "live_action"]
    },
    "genre": {
      "type": "string",
      "minLength": 1
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/episode"
      }
    }
  },
  "$defs": {
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ep_no", "scenes"],
      "properties": {
        "ep_no": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scene"
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ep_no",
        "scene_no",
        "location",
        "time_of_day",
        "interior_exterior",
        "characters",
        "lines"
      ],
      "properties": {
        "ep_no": {
          "type": "integer",
          "minimum": 1
        },
        "scene_no": {
          "type": "integer",
          "minimum": 1
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "time_of_day": {
          "type": "string",
          "enum": ["日", "夜", "晨", "昏", "黄昏", "凌晨", "傍晚"]
        },
        "interior_exterior": {
          "type": "string",
          "enum": ["内", "外"]
        },
        "is_flashback": {
          "type": "boolean"
        },
        "characters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/line"
          }
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["action", "closeup", "caption", "dialogue", "os", "vo"]
        },
        "speaker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "emotion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
